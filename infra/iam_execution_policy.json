{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIAMReadOnly",
      "Effect": "Allow",
      "Action": [
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicies",
        "iam:ListPolicyVersions",
        "iam:ListUsers",
        "iam:ListAccessKeys",
        "iam:GetAccessKeyLastUsed",
        "iam:ListRoles",
        "iam:GetRole",
        "iam:SimulateCustomPolicy"
      ],
      "Resource": "*"
    }
  ]
}
